{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pensieve",
  "version": "0.5.5",
  "identifier": "com.pensieve.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Pensieve",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https: http:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["English", "Slovenian"],
        "customLanguageFiles": {
          "English": "installer/English.nsh",
          "Slovenian": "installer/Slovenian.nsh"
        }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": []
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENEVGRjYyQUY2MDg3QzgKUldUSWgyQ3ZZdjlPUGNWTC80NzFCdDhVZUNFc3NsMHFDUmVSTE9pVkROVjNPbUlBZDIzMUZ6UlQK",
      "endpoints": [
        "https://github.com/nebevk/pensieve-writer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
